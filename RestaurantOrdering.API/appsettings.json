{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=restaurant.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "RestaurantOrdering.API",
    "Audience": "RestaurantOrdering.Client",
    "SecretKey": "Your-super-secret-key-that-is-at-least-256-bits-long-for-jwt-token-generation",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedHosts": "*"
}
